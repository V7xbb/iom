# Backend
DATABASE_URL=sqlite:///./hkrroe.db
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
VISITOR_HASH_SECRET=replace-with-a-different-random-secret
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=use-a-long-unique-password-of-12-characters-or-more
CORS_ORIGINS=http://localhost:3000

# Frontend (set in frontend/.env.local locally; set in Render for deployment)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
